{
  "compilerOptions": {
    "module": "es6",
    "target": "es6",
    "lib": [
      "es2021",
      "DOM"
    ],
    "strict": true,
    "strictNullChecks": false,
    "noEmitHelpers": true,
    "sourceMap": false,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "paths": {
      "~/packages/*": [
        "./library/packages/*"
      ]
    }
  },
  "include": [
    "./assets",
    "./src",
    "./packages",
    "./engine"
  ]
}